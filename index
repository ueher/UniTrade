                laser.classList.add('d-none');
                if (isSuccess) {
                    isBarcodeVerified = true;
                    resultBox.innerHTML = `
                        <div class="p-2 rounded-3 bg-success-subtle border border-success text-success fw-bolder" style="font-size: 0.92rem;">
