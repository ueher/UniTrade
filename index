            const emailErr = document.getElementById('emailErrorFeedback');
            const pwdErr = document.getElementById('pwdErrorFeedback');

            emailErr.classList.add('d-none');
            pwdErr.classList.add('d-none');

            if (!emailVal || !emailVal.endsWith('@st.ueh.edu.vn') || emailVal.length <= '@st.ueh.edu.vn'.length) {
                emailErr.classList.remove('d-none');
                emailInput.focus();
                return;
            }

            if (!pwdVal || pwdVal.length < 3) {
                pwdErr.classList.remove('d-none');
                pwdInput.focus();
                return;
            }

            let displayName = nameInput.value.trim();
            if (!displayName) {
                const prefix = emailVal.split('@')[0].replace(/[0-9._-]/g, ' ').trim();
                displayName = prefix ? ('SV UEH (' + prefix + ')') : 'Nguyễn Khánh Huyền';
