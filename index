        function pickSampleProductImg(index) {
            const chosen = SAMPLE_THUMBS[index];
            if (!chosen) return;
            if (addImageToUploadList(chosen.src, chosen.label)) {
                showToast(`Đã thêm "${chosen.label}" (${uploadedImagesList.length}/${MAX_UPLOAD_IMAGES} ảnh)`);
            }
        }

        function handleRealImageUpload(event) {
            const files = Array.from(event.target.files || []);
            if (files.length === 0) return;

            const remainingSlots = MAX_UPLOAD_IMAGES - uploadedImagesList.length;
            if (remainingSlots <= 0) {
                showToast('Bạn đã tải đủ tối đa 5 ảnh!');
                event.target.value = '';
                return;
            }

            if (files.length > remainingSlots) {
                showToast(`Chỉ được tối đa 5 ảnh! Hệ thống sẽ chỉ lấy ${remainingSlots} ảnh đầu tiên.`);
            }

            const filesToRead = files.slice(0, remainingSlots);
            filesToRead.forEach(file => {
                if (!file.type.startsWith('image/')) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    addImageToUploadList(e.target.result, file.name);
                };
                reader.readAsDataURL(file);
            });

            event.target.value = '';
        }

