                resultBox.classList.remove('d-none');
                resultBox.innerHTML = `
                    <div class="p-2 rounded-3 bg-danger-subtle border border-danger text-danger fw-bolder" style="font-size: 0.92rem;">
                        <i class="fa-solid fa-circle-xmark me-2"></i>Vui lòng quét lại để được duyệt.
                    </div>
                `;
                document.getElementById('bookBarcodeStep').scrollIntoView({ behavior: 'smooth', block: 'center' });
                showToast('Vui lòng quét lại để được duyệt.');
                return;
            }

            const sellerFullName = currentUser ? currentUser.name : 'Nguyễn Khánh Huyền';
            const coverImage = uploadedImagesList[0] || IMG_UEH_POLO;

            const newProduct = {
                id: Date.now(),
                title: title,
                category: category,
                price: price,
                seller: sellerFullName,
                campus: campus,
                postedAgo: 'Vừa đăng xong',
                condition: condition,
                image: coverImage,
                desc: desc
            };

            products.unshift(newProduct);
            mySellingItems.unshift({
                id: newProduct.id,
                title: newProduct.title,
                category: newProduct.category,
                price: newProduct.price,
                campus: newProduct.campus,
                condition: newProduct.condition,
                image: newProduct.image
            });

            renderHomeProducts();
            renderAccountLists();

            document.getElementById('sellForm').reset();
            clearUploadedImage();
            handleCategoryChange();

            showToast(`Đã đăng tin pass "${title}" thành công lên Trang chủ!`);
            switchTab('home');
        }

        function setupDragAndDropUpload() {
            const dropzone = document.getElementById('uploadDropzone');
            if (!dropzone) return;

            ['dragenter', 'dragover'].forEach(evtName => {
                dropzone.addEventListener(evtName, e => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('dragover');
                });
            });

            ['dragleave', 'drop'].forEach(evtName => {
                dropzone.addEventListener(evtName, e => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('dragover');
                });
            });

            dropzone.addEventListener('drop', e => {
                const files = Array.from(e.dataTransfer.files || []).filter(f => f.type.startsWith('image/'));
                if (files.length === 0) return;

                const remainingSlots = MAX_UPLOAD_IMAGES - uploadedImagesList.length;
                if (remainingSlots <= 0) {
                    showToast('Chỉ được tải lên tối đa 5 ảnh!');
                    return;
                }

                if (files.length > remainingSlots) {
                    showToast(`Chỉ được tối đa 5 ảnh! Hệ thống sẽ lấy ${remainingSlots} ảnh đầu tiên.`);
                }

                files.slice(0, remainingSlots).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (ev) {
                        addImageToUploadList(ev.target.result, file.name);
                    };
                    reader.readAsDataURL(file);
                });
            });
        }

        // =========================================================================
        // 8. GIỎ HÀNG CỦA TÔI
        // =========================================================================
        function addProductToCart(prodId) {
            if (!requireAuthentication()) return;

            const prod = products.find(p => p.id === prodId);
            if (!prod) return;

            const existing = cart.find(c => c.id === prodId);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({
                    id: prod.id,
                    title: prod.title,
                    seller: prod.seller,
                    price: prod.price,
                    qty: 1,
                    image: prod.image
                });
            }

            renderCart();
            showToast(`Đã thêm "${prod.title}" vào Giỏ hàng của tôi!`);
        }

        function changeCartQty(itemId, delta) {
            const item = cart.find(c => c.id === itemId);
            if (!item) return;
            item.qty += delta;
            if (item.qty <= 0) {
                cart = cart.filter(c => c.id !== itemId);
            }
            renderCart();
        }

        function removeCartItem(itemId) {
            cart = cart.filter(c => c.id !== itemId);
            renderCart();
            showToast('Đã xóa sản phẩm khỏi giỏ hàng.');
        }

        function renderCart() {
            const tbody = document.getElementById('cartTableBody');
            const totalQty = currentUser ? cart.reduce((s, i) => s + i.qty, 0) : 0;
            document.getElementById('cartBadge').textContent = totalQty;

            if (cart.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            Giỏ hàng của bạn đang trống. Hãy thêm sản phẩm từ Trang chủ nhé!
                        </td>
                    </tr>
                `;
                document.getElementById('cartSubtotalText').textContent = '0đ';
                document.getElementById('cartTotalText').textContent = '0đ';
                return;
            }

            let sum = 0;
            tbody.innerHTML = cart.map(item => {
                const lineTotal = item.price * item.qty;
                sum += lineTotal;
                return `
                    <tr>
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="${item.image}" class="rounded-2 border" style="width: 54px; height: 54px; object-fit: cover;" alt="${item.title}">
                                <div>
                                    <div class="fw-bold text-dark">${item.title}</div>
                                    <small class="text-muted">Người bán: ${item.seller}</small>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm border rounded-2">
                                <button type="button" onclick="changeCartQty(${item.id}, -1)" class="btn btn-light fw-bold">-</button>
                                <span class="btn btn-white disabled fw-bold text-dark px-3">${item.qty}</span>
                                <button type="button" onclick="changeCartQty(${item.id}, 1)" class="btn btn-light fw-bold">+</button>
                            </div>
                        </td>
                        <td class="text-end fw-semibold">${formatVND(item.price)}</td>
                        <td class="text-end fw-bolder" style="color: var(--ueh-teal);">${formatVND(lineTotal)}</td>
                        <td class="text-center pe-3">
                            <button onclick="removeCartItem(${item.id})" class="btn btn-sm text-danger">
                                <i class="fa-solid fa-trash-can me-1"></i>Xóa
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            document.getElementById('cartSubtotalText').textContent = formatVND(sum);
            document.getElementById('cartTotalText').textContent = formatVND(sum);
        }

        function checkoutCartItems() {
            if (cart.length === 0) {
                showToast('Giỏ hàng đang trống, vui lòng chọn món đồ trước khi đặt mua!');
                return;
            }

            cart.forEach(c => {
                shippingOrders.unshift({
                    orderNo: 'UEH-' + Math.floor(100000 + Math.random() * 900000),
                    title: `${c.title} (x${c.qty})`,
                    seller: c.seller,
                    price: c.price * c.qty,
                    shipper: 'Trần Quốc Bảo',
                    eta: '15 phút nữa tới sảnh',
                    image: c.image
                });
            });

            cart = [];
            renderCart();
            renderShippingOrders();
            switchTab('orders');
            switchOrderTab('shipping');
            showToast(`Đặt mua thành công! Đơn hàng đang được giao tới ${UEH_CAMPUSES[selectedCampusCode].address}`);
        }

        // =========================================================================
        // 9. TIN NHẮN & ĐƠN HÀNG (GOOGLE MAPS 3 CƠ SỞ UEH)
        // =========================================================================
        function renderConversations() {
            const listEl = document.getElementById('conversationListBox');
            listEl.innerHTML = conversations.map(c => `
                <button type="button" onclick="selectConversation(${c.id})" class="list-group-item list-group-item-action p-3 border-0 border-bottom ${c.id === activeConvId ? 'bg-info bg-opacity-10 border-start border-4' : ''}" style="${c.id === activeConvId ? 'border-left-color: var(--ueh-teal) !important;' : ''}">
                    <div class="d-flex align-items-center gap-2">
                        <img src="${c.avatar}" class="rounded-circle border" style="width: 42px; height: 42px; object-fit: cover;" alt="${c.name}">
                        <div class="overflow-hidden flex-grow-1">
                            <div class="fw-bold text-dark text-truncate" style="font-size: 0.86rem;">${c.name}</div>
                            <div class="text-truncate fw-semibold" style="font-size: 0.74rem; color: var(--ueh-orange);">${c.item}</div>
                            <div class="text-muted text-truncate" style="font-size: 0.74rem;">${c.messages[c.messages.length - 1].text}</div>
                        </div>
                    </div>
                </button>
            `).join('');

            const activeConv = conversations.find(c => c.id === activeConvId);
            if (!activeConv) return;

            document.getElementById('chatHeaderAvatar').src = activeConv.avatar;
            document.getElementById('chatHeaderName').textContent = activeConv.name;
            document.getElementById('chatHeaderItem').textContent = 'Đang trao đổi: ' + activeConv.item;

            const msgBox = document.getElementById('chatMessagesBox');
            msgBox.innerHTML = activeConv.messages.map(m => `
                <div class="d-flex mb-2 ${m.from === 'me' ? 'justify-content-end' : 'justify-content-start'}">
                    <div class="px-3 py-2 rounded-4 shadow-sm" style="max-width: 78%; font-size: 0.85rem; ${m.from === 'me' ? 'background-color: var(--ueh-teal); color: #fff;' : 'background-color: #fff; border: 1px solid #E2E8F0; color: #1E293B;'}">
                        ${m.text}
                    </div>
                </div>
            `).join('');
            msgBox.scrollTop = msgBox.scrollHeight;
        }

        function selectConversation(id) {
            activeConvId = id;
            renderConversations();
        }

        function handleSendChat(event) {
            event.preventDefault();
            const input = document.getElementById('chatTextInput');
            const text = input.value.trim();
            if (!text) return;
            sendQuickMessage(text);
            input.value = '';
        }

        function sendQuickMessage(text) {
            const conv = conversations.find(c => c.id === activeConvId);
            if (!conv) return;
            conv.messages.push({ from: 'me', text: text });
            renderConversations();

            setTimeout(() => {
                conv.messages.push({
                    from: 'them',
                    text: 'Dạ mình nhận được tin nhắn rồi nha, hẹn gặp bạn tại sảnh cơ sở UEH nhé!'
                });
                renderConversations();
            }, 600);
        }

        function switchOrderTab(subTab) {
            document.querySelectorAll('.order-panel').forEach(p => p.classList.add('d-none'));
            document.getElementById('order-panel-' + subTab).classList.remove('d-none');

            ['pending', 'shipping', 'completed', 'review'].forEach(t => {
                const btn = document.getElementById('order-tab-' + t);
                if (t === subTab) {
                    btn.className = 'btn btn-ueh-teal w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2';
                } else {
                    btn.className = 'btn btn-outline-secondary w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2';
                }
            });
        }

        function changeDefaultCampus(code) {
            selectOrderCampusMap(code);
            showToast('Đã chọn địa điểm nhận hàng: ' + UEH_CAMPUSES[code].address);
        }

        function selectOrderCampusMap(code) {
            selectedCampusCode = code;
            const campus = UEH_CAMPUSES[code];
            if (!campus) return;

            ['A', 'B', 'N'].forEach(c => {
                const card = document.getElementById('campus-card-' + c);
                if (c === code) {
                    card.className = 'p-2 rounded-3 bg-white border border-2 h-100 shadow-sm';
                    card.style.borderColor = 'var(--ueh-teal)';
                } else {
                    card.className = 'p-2 rounded-3 bg-white border h-100';
                    card.style.borderColor = '#dee2e6';
                }
            });

            document.getElementById('mapActiveAddressLabel').textContent = campus.address;
            document.getElementById('orderGoogleMapFrame').src = `https://maps.google.com/maps?q=${encodeURIComponent(campus.mapQuery)}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
            document.getElementById('cartCampusSelect').value = code;
            renderShippingOrders();
        }

        function renderShippingOrders() {
            const container = document.getElementById('shippingOrdersContainer');
            const campus = UEH_CAMPUSES[selectedCampusCode];

            document.getElementById('shippingCountBadge').textContent = shippingOrders.length;
            document.getElementById('orderBadge').textContent = shippingOrders.length;

            container.innerHTML = shippingOrders.map(ord => `
                <div class="p-3 rounded-3 border bg-white shadow-sm">
                    <div class="d-flex gap-3 align-items-center mb-2">
                        <img src="${ord.image}" class="rounded-2 border" style="width: 58px; height: 58px; object-fit: cover;" alt="${ord.title}">
                        <div class="overflow-hidden flex-grow-1">
                            <div class="fw-bold text-dark text-truncate" style="font-size: 0.88rem;">${ord.title}</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Người bán: ${ord.seller} • Mã đơn: ${ord.orderNo}</div>
                            <div class="fw-bolder" style="color: var(--ueh-orange); font-size: 0.88rem;">${formatVND(ord.price)}</div>
                        </div>
                    </div>
                    <div class="p-2 rounded-2 bg-light border small" style="font-size: 0.75rem;">
                        <div><strong>Người giao:</strong> ${ord.shipper} (${ord.eta})</div>
                        <div class="text-muted mt-1"><strong>Điểm nhận:</strong> ${campus.address}</div>
                    </div>
                </div>
            `).join('');
        }

        // =========================================================================
        // 10. QUẢN LÝ TÀI KHOẢN CỦA TÔI
        // =========================================================================
        function switchAccountPanel(panelName) {
            document.querySelectorAll('.acc-panel').forEach(p => p.classList.add('d-none'));
            document.getElementById('acc-panel-' + panelName).classList.remove('d-none');

            ['profile', 'selling', 'sold', 'history', 'settings'].forEach(name => {
                const btn = document.getElementById('acc-nav-' + name);
                if (name === panelName) {
                    btn.className = 'btn btn-ueh-teal text-start fw-bold py-2 px-3 rounded-3 d-flex justify-content-between align-items-center';
                } else {
                    btn.className = 'btn btn-light text-start fw-semibold py-2 px-3 rounded-3 d-flex justify-content-between align-items-center';
                }
            });
        }

        function renderAccountLists() {
            document.getElementById('accSellingBadge').textContent = mySellingItems.length;
            document.getElementById('accSoldBadge').textContent = mySoldItems.length;

            const sellingBox = document.getElementById('mySellingContainer');
            sellingBox.innerHTML = mySellingItems.map(item => `
                <div class="p-3 rounded-3 border d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <img src="${item.image}" class="rounded-2 border" style="width: 56px; height: 56px; object-fit: cover;" alt="${item.title}">
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">${item.title}</div>
                            <div class="text-muted" style="font-size: 0.76rem;">${item.category} • ${item.campus} • ${item.condition}</div>
                            <div class="fw-bolder" style="color: var(--ueh-orange);">${formatVND(item.price)}</div>
                        </div>
                    </div>
                    <button onclick="markItemSold(${item.id})" class="btn btn-sm btn-success fw-bold">
                        <i class="fa-solid fa-check me-1"></i>Đánh dấu Đã bán
                    </button>
                </div>
            `).join('');

            const soldBox = document.getElementById('mySoldContainer');
            soldBox.innerHTML = mySoldItems.map(item => `
                <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                    <div>
                        <span class="badge bg-success mb-1">Đã bán hoàn tất</span>
                        <div class="fw-bold text-dark" style="font-size: 0.9rem;">${item.title}</div>
                        <small class="text-muted">Người mua: ${item.buyer} • Giao tại: ${item.campus}</small>
                    </div>
                    <div class="fw-bolder text-success">+${formatVND(item.price)}</div>
                </div>
            `).join('');
        }

        function markItemSold(itemId) {
            const idx = mySellingItems.findIndex(i => i.id === itemId);
            if (idx === -1) return;
            const sold = mySellingItems.splice(idx, 1)[0];
            mySoldItems.unshift({
                id: sold.id,
                title: sold.title,
                price: sold.price,
                buyer: 'Sinh viên UEH',
                campus: sold.campus
            });
            renderAccountLists();
            showToast(`Đã chuyển "${sold.title}" sang mục Hàng đã bán!`);
        }

        function saveProfileInfo(event) {
            event.preventDefault();
            const newName = document.getElementById('inputProfName').value.trim();
            if (currentUser && newName) {
                currentUser.name = newName;
                document.getElementById('headerUserName').textContent = newName;
                document.getElementById('accProfileName').textContent = newName;
            }
            showToast('Đã lưu cập nhật Hồ sơ sinh viên thành công!');
        }

        function showToast(msg) {
            document.getElementById('toastMsgContent').textContent = msg;
            const toastEl = document.getElementById('liveToast');
            const toast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3200 });
            toast.show();
        }

        // Khởi tạo ứng dụng khi mở trang
        window.onload = function () {
            document.getElementById('pendingOrderSampleImg').src = IMG_BOOK_MARKETING;
            document.getElementById('completedOrderSampleImg').src = IMG_BOOK_FINANCE;

            renderHomeProducts();
            renderSampleThumbs();
            renderUploadedFiveSlots();
            handleCategoryChange();
            setupDragAndDropUpload();
            renderCart();
            renderConversations();
            renderShippingOrders();
            renderAccountLists();
        };
    </script>
</body>
</html>
