        function handleCategoryChange() {
            const cat = document.getElementById('sellCategory').value;
            const barcodeStep = document.getElementById('bookBarcodeStep');
            const resultBox = document.getElementById('barcodeScanResultBox');

            if (cat === 'Sách & Giáo trình') {
